<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Who Are Ya?</title>
    <link rel="stylesheet" href="/auth/css/auth.css">
    <link rel="stylesheet" href="/auth/css/oauth.css">
</head>
<body class="auth-page">
    <div class="auth-container">
        <div class="auth-card">
            <h1 class="auth-title">Iniciar Sesión</h1>

            <!-- Mostrar errores generales -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="auth-alert">
                    <%= error %>
                </div>
            <% } %>

            <!-- Mostrar mensaje de error de query string -->
            <% if (typeof queryError !== 'undefined' && queryError) { %>
                <div class="auth-alert">
                    <%= queryError %>
                </div>
            <% } %>

            <!-- Mostrar mensaje de éxito (ej: después de registro) -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="auth-alert auth-alert-success">
                    <%= success %>
                </div>
            <% } %>

            <form id="loginForm" class="auth-form">
                <div class="auth-field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required
                           class="auth-input"
                           placeholder="tu@email.com"
                           autocomplete="email">
                </div>

                <div class="auth-field">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" name="password" required
                           class="auth-input"
                           placeholder="Tu contraseña"
                           autocomplete="current-password">
                </div>

                <button type="submit" id="submitBtn" class="auth-btn">
                    Iniciar Sesión
                </button>
            </form>

            <div class="auth-divider">
                <span>o continúa con</span>
            </div>

            <div class="oauth-buttons">
                <a href="/auth/google" class="oauth-btn oauth-google">
                    <svg width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Google
                </a>
                <a href="/auth/github" class="oauth-btn oauth-github">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    GitHub
                </a>
            </div>

            <p class="auth-links">
                ¿No tienes cuenta? <a href="/register">Regístrate</a>
            </p>

                <div class="oauth-buttons">
                    <a href="/auth/google" class="oauth-btn google-btn">
                        <svg class="oauth-icon" viewBox="0 0 24 24" width="20" height="20">
                            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                        </svg>
                        Google
                    </a>

                    <a href="/auth/github" class="oauth-btn github-btn">
                        <svg class="oauth-icon" viewBox="0 0 24 24" width="20" height="20">
                            <path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        GitHub
                    </a>
                </div>
            </div>


            <!-- Enlaces adicionales -->
            <div class="auth-footer">
                <p class="auth-links">
                    ¿No tienes cuenta? <a href="/register">Regístrate</a>
                </p>

                <a href="/" class="auth-back">
                    ← Volver al juego
                </a>
            </div>
        </div>
    </div>

    <script src="/auth/js/login.js" defer></script>

        <!-- Script para manejar errores de query string -->
        <script>
            // Leer parámetros de error de la URL
            const urlParams = new URLSearchParams(window.location.search);
            const errorType = urlParams.get('error');

            if (errorType) {
                let errorMessage = '';
                switch(errorType) {
                    case 'google':
                        errorMessage = 'Error al iniciar sesión con Google. Inténtalo de nuevo.';
                        break;
                    case 'github':
                        errorMessage = 'Error al iniciar sesión con GitHub. Inténtalo de nuevo.';
                        break;
                    case 'oauth':
                        errorMessage = 'Error en la autenticación OAuth. Inténtalo más tarde.';
                        break;
                    default:
                        errorMessage = 'Error desconocido en la autenticación.';
                }

                // Mostrar mensaje de error
                const errorDiv = document.createElement('div');
                errorDiv.className = 'auth-alert';
                errorDiv.textContent = errorMessage;

                const form = document.getElementById('loginForm');
                if (form && form.parentNode) {
                    form.parentNode.insertBefore(errorDiv, form);
                }

                // Limpiar la URL
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        </script>
</body>
</html>
