<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/admin/css/admin.css">
</head>
<body>
  <%- include('../partials/admin-header', { page: 'dashboard', user: user }) %>

  <main class="admin-main">
    <div class="container">
      <div class="form-header">
        <h2>Editar Jugador</h2>
        <a href="/admin" class="btn btn-secondary">← Volver</a>
      </div>

      <!-- Loading spinner mientras carga datos -->
      <div id="loading" class="loading">Cargando datos del jugador...</div>

      <!-- Mensajes de error/éxito -->
      <div id="form-message" class="alert" style="display: none;"></div>

      <!-- Formulario -->
      <form id="player-form" class="player-form" style="display: none;">
        <input type="hidden" id="player-id" value="<%= playerId %>">

        <div class="form-row">
          <div class="form-group">
            <label for="name">Nombre *</label>
            <input type="text" id="name" name="name" required>
            <span class="error-message" id="name-error"></span>
          </div>

          <div class="form-group">
            <label for="birthDate">Fecha de Nacimiento *</label>
            <input type="date" id="birthDate" name="birthDate" required>
            <span class="error-message" id="birthDate-error"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="team-select-container">Equipo *</label>
            <div id="team-select-container"></div>
            <span class="error-message" id="team-error"></span>
          </div>

          <div class="form-group">
            <label for="league-select-container">Liga *</label>
            <div id="league-select-container"></div>
            <p id="league-name" class="league-name"></p>
            <span class="error-message" id="league-error"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="nationality">Nacionalidad *</label>
            <input type="text" id="nationality" name="nationality" required>
            <span class="error-message" id="nationality-error"></span>
          </div>

          <div class="form-group">
            <label for="position">Posición *</label>
            <select id="position" name="position" required>
              <option value="">Selecciona posición</option>
              <option value="Portero">Portero</option>
              <option value="Defensa">Defensa</option>
              <option value="Centrocampista">Centrocampista</option>
              <option value="Delantero">Delantero</option>
            </select>
            <span class="error-message" id="position-error"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="image">Cambiar foto del jugador</label>
            <input type="file" id="image" name="image" accept="image/*">
            <span class="error-message" id="image-error"></span>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <span class="btn-text">Guardar Cambios</span>
            <span class="btn-loading" style="display: none;">Guardando...</span>
          </button>
          <a href="/admin" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

  <%- include('../partials/admin-footer') %>

  <!-- Scripts -->
  <script type="module" src="/admin/js/api-client.js"></script>
  <script type="module" src="/admin/js/player-edit.js"></script>
</body>
</html>
